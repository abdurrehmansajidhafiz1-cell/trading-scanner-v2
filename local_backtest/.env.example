# Copy this file to ".env" (same folder) and fill in what you need.
# Everything here is OPTIONAL — the backtest runs and saves full local
# reports (output/backtest_report.txt + output/backtest_zones.csv) even if
# you leave every line below untouched or blank.

# --- Backtest window ---
BACKTEST_DAYS=365
WARMUP_DAYS=90

# --- Output folder (relative to local_backtest/, or an absolute path) ---
OUTPUT_DIR=output

# --- Email (leave SEND_EMAIL=false to skip email entirely) ---
SEND_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=

# --- Same strategy risk parameter as the live system (leave default unless
#     you deliberately changed MIN_RR in the main config.py too) ---
MIN_RR=1.5
